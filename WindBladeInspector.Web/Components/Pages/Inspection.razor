    [Parameter]
    public Guid? ProjectId { get; set; }

    protected override void OnInitialized()
    {
        if (ProjectId.HasValue)
        {
            State.Project = DashboardService.GetProjectById(ProjectId.Value);
            if (State.Project != null && State.Project.Blades.Count > 0)
                SelectBlade(State.Project.Blades[0]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            State.DotNetRef = DotNetObjectReference.Create<object>(this);
            await JSRuntime.InvokeVoidAsync("setupKeyboardNavigation", State.DotNetRef);
        }
    }

    private void ToggleLeftPanel()
    {
        State.IsLeftPanelCollapsed = !State.IsLeftPanelCollapsed;
        StateHasChanged();
    }

    private void SelectBlade(Blade blade)
    {
        Logger.LogInformation("Blade selected: {BladeSerial}", blade.SerialNumber);
        State.SelectedBlade   = blade;
        State.SelectedAnomaly = null;
        State.SelectedView    = "PS";

        foreach (var side in new[] { "PS", "SS", "LE", "TE" })
            if (!blade.Views.Any(v => v.Side == side))
                blade.Views.Add(new BladeView { Side = side });

        UpdateSelectedViewImages();

        // Auto-select first image if available
        if (State.SelectedViewImages.Count > 0)
            SelectImageDirect(State.SelectedViewImages[0]);

        StateHasChanged();
    }

    private async void SelectView(string view)
    {
        Logger.LogInformation("View changed to: {View}", view);
        State.SelectedView        = view;
        State.SelectedImage       = null;
        State.ImageUrl            = string.Empty;
        State.IsCanvasInitialized = false;
        State.CurrentAnomaly      = null;

        try { await JSRuntime.InvokeVoidAsync("inspectionCanvas.clearAll"); }
        catch { /* canvas may not be ready */ }

        UpdateSelectedViewImages();

        // Auto-select first image in the new view if available
        if (State.SelectedViewImages.Count > 0)
            SelectImageDirect(State.SelectedViewImages[0]);

        StateHasChanged();
    }

    private void UpdateSelectedViewImages()
    {
        if (State.SelectedBlade == null || string.IsNullOrEmpty(State.SelectedView))
        {
            State.SelectedViewImages = new();
            return;
        }
        var view = State.SelectedBlade.Views.FirstOrDefault(v => v.Side == State.SelectedView);
        State.SelectedViewImages = view?.Images.OrderBy(i => i.SequenceOrder).ToList() ?? new();
    }

    private string GetViewLabel(string side) => side switch
    {
        "PS" => "PS",
        "SS" => "SS",
        "LE" => "LE",
        "TE" => "TE",
        _    => side
    };

    private string GetShortDefectDisplay(Anomaly anomaly)
    {
        if (anomaly.Classification != null)
        {
            var defectType = anomaly.Classification.GetDefectTypeString();
            var subtype    = anomaly.Classification.GetDefectSubtypeString();
            return !string.IsNullOrEmpty(subtype) && subtype != "None"
                ? $"{defectType} – {subtype}"
                : defectType;
        }
        return anomaly.Type;
    }

    private void SelectAnomaly(Anomaly anomaly)
    {
        State.SelectedAnomaly = anomaly;
        StateHasChanged();
    }

    private void OnCurrentDefectClassificationChanged(DefectClassification? classification)
    {
        if (State.CurrentAnomaly == null) return;
        State.CurrentAnomaly.Classification = classification;
        if (classification != null)
            State.CurrentAnomaly.Type = classification.GetDefectTypeString();
        Logger.LogInformation("Current defect classification: {Path}", classification?.GetFullPath() ?? "None");
        StateHasChanged();
    }

    private void OnSelectedDefectClassificationChanged(DefectClassification? classification)
    {
        if (State.SelectedAnomaly == null) return;
        State.SelectedAnomaly.Classification = classification;
        if (classification != null)
            State.SelectedAnomaly.Type = classification.GetDefectTypeString();
        Logger.LogInformation("Selected defect classification: {Path}", classification?.GetFullPath() ?? "None");
        StateHasChanged();
    }

    private async Task OnImageLoaded()
    {
        if (!State.IsCanvasInitialized && State.DotNetRef != null)
        {
            await Task.Delay(80);
            var ok = await JSRuntime.InvokeAsync<bool>(
                "inspectionCanvas.initialize",
                "inspectionCanvas",
                State.DotNetRef,
                "bladeImage",
                "canvasContainer");
            State.IsCanvasInitialized = ok;
            await SetModeInternal("inspect");
            await ResetView();
            await LoadExistingDefectsOnCanvas();
        }
    }

    private async Task SetModeInternal(string mode)
    {
        State.CurrentMode = mode;
        if (State.IsCanvasInitialized)
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.setMode", mode);
        StateHasChanged();
    }
    // 1. Toggle Mode Method
    private async Task ToggleDrawingMode()
    {
        State.IsDrawingMode = !State.IsDrawingMode;

        if (State.IsCanvasInitialized)
        {
            // Tell JS to switch to 'draw' or 'inspect' mode
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.setMode", State.IsDrawingMode ? "draw" : "inspect");
        }

        StateHasChanged();
    }

    [JSInvokable]
    public void ReceiveSelection(double x, double y, double width, double height, double refWidth, double refHeight)
    {
        if (!State.IsDrawingMode) return;
        State.CurrentWidthPx = width;
        State.CurrentHeightPx = height;
        State.CurrentWidthPct = (width / refWidth) * 100;
        State.CurrentHeightPct = (height / refHeight) * 100;
        State.CurrentCanvasBoxIndex = State.SelectedImage?.Anomalies.Count ?? 0;

        double scaleX = refWidth / 100.0;
        double scaleY = refHeight / 100.0;

        State.CurrentAnomaly = new Anomaly
        {
            AnomalyId    = $"NEW#{DateTime.Now.Ticks % 10000:X4}",
            RadiusMeters = State.SelectedImage?.PositionMeters ?? 0,
            BladeSide    = State.SelectedView ?? "PS",
            WidthCm      = width  / scaleX,
            HeightCm     = height / scaleY,
            AreaCm2      = (width * height) / (scaleX * scaleY),
            Type         = "Other",
            Classification = null,
            Coordinates  = new ImageCoordinates
            {
                X = x, Y = y, Width = width, Height = height,
                ReferenceWidth = refWidth, ReferenceHeight = refHeight
            }
        };
        StateHasChanged();
    }

    [JSInvokable]
    public void ReceiveZoomChange(double newZoom)
    {
        State.ZoomLevel = newZoom;
        StateHasChanged();
    }

    [JSInvokable] public void NavigateNext()     => NextImage();
    [JSInvokable] public void NavigatePrevious() => PrevImage();

    [JSInvokable]
    public void ReceiveBoxSelected(int index)
    {
        if (State.SelectedImage == null || index < 0) return;

        // We must match the exact filtered list that the canvas is using
        var canvasDefects = State.SelectedImage.Anomalies
            .Where(a => a.Coordinates != null)
            .ToList();

        if (index >= canvasDefects.Count) return;

        // Load the exact clicked defect into the left panel
        State.SelectedAnomaly = canvasDefects[index];
        State.CurrentAnomaly = null; // Close the "New Defect" form if it's open
        State.IsLeftPanelCollapsed = false; // Pop open the left panel

        StateHasChanged();
    }
    [JSInvokable]
    public void ReceiveBoxDeselected()
    {
        State.SelectedAnomaly = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void ReceiveBoxDeleted(int index)
    {
        if (State.SelectedImage == null || index < 0) return;

        // FIX: Match the exact filtered list that the canvas uses
        var canvasDefects = State.SelectedImage.Anomalies.Where(a => a.Coordinates != null).ToList();
        if (index >= canvasDefects.Count) return;

        var deleted = canvasDefects[index];
        Logger.LogInformation("Box #{Index} deleted from canvas", index + 1);

        // Remove using AnomalyId
        State.SelectedImage.Anomalies.RemoveAll(a => a.AnomalyId == deleted.AnomalyId);
        State.SelectedBlade?.Anomalies.RemoveAll(a => a.AnomalyId == deleted.AnomalyId);

        if (State.SelectedAnomaly?.AnomalyId == deleted.AnomalyId)
            State.SelectedAnomaly = null;

        if (State.Project != null)
            DashboardService.SaveProject(State.Project);

        StateHasChanged();
    }

    // Changed from "private void" to "private async Task"
    private async Task SaveAnomaly()
    {
        if (State.CurrentAnomaly == null || State.SelectedBlade == null) return;

        if (State.CurrentAnomaly.Classification == null)
        {
            Logger.LogWarning("Attempted to save defect without classification");
            return;
        }

        // Link explicitly to the current image
        State.CurrentAnomaly.ImageId = State.SelectedImage?.Id ?? Guid.Empty;
        State.CurrentAnomaly.BladeSide = State.SelectedView;

        State.SelectedBlade.Anomalies.Add(State.CurrentAnomaly);
        State.SelectedImage?.Anomalies.Add(State.CurrentAnomaly);

        if (State.Project != null)
            DashboardService.SaveProject(State.Project);

        State.CurrentAnomaly = null;
        State.IsDrawingMode = false;
        StateHasChanged();

        // 🚀 THE FIX: Tell JavaScript that drawing mode is OFF!
        try { await JSRuntime.InvokeVoidAsync("inspectionCanvas.setMode", "inspect"); } catch { }

        // Force the canvas to delete the temporary box and load the saved data!
        try { await JSRuntime.InvokeVoidAsync("inspectionCanvas.clearAll"); } catch { }
        await LoadExistingDefectsOnCanvas();
    }

    private async Task UpdateAnomaly()
    {
        if (State.SelectedAnomaly == null) return;

        // 1. Sync the Blade's copy (This updates the Left Menu)
        if (State.SelectedBlade != null)
        {
            var bladeAnomaly = State.SelectedBlade.Anomalies.FirstOrDefault(a => a.AnomalyId == State.SelectedAnomaly.AnomalyId);
            if (bladeAnomaly != null && !ReferenceEquals(bladeAnomaly, State.SelectedAnomaly))
            {
                bladeAnomaly.Severity = State.SelectedAnomaly.Severity;
                bladeAnomaly.Classification = State.SelectedAnomaly.Classification;
                bladeAnomaly.Type = State.SelectedAnomaly.Type;
                bladeAnomaly.BladeSide = State.SelectedAnomaly.BladeSide;
            }
        }

        // 2. Sync the Image's copy (This updates the Canvas)
        if (State.SelectedImage != null)
        {
            var imageAnomaly = State.SelectedImage.Anomalies.FirstOrDefault(a => a.AnomalyId == State.SelectedAnomaly.AnomalyId);
            if (imageAnomaly != null && !ReferenceEquals(imageAnomaly, State.SelectedAnomaly))
            {
                imageAnomaly.Severity = State.SelectedAnomaly.Severity;
                imageAnomaly.Classification = State.SelectedAnomaly.Classification;
                imageAnomaly.Type = State.SelectedAnomaly.Type;
                imageAnomaly.BladeSide = State.SelectedAnomaly.BladeSide;
            }
        }

        // Persist the changes to the database
        if (State.Project != null)
            DashboardService.SaveProject(State.Project);

        // Deselect the anomaly to close the left panel form
        State.SelectedAnomaly = null;
        StateHasChanged();

        // Refresh the canvas to update the box colors/labels
        await LoadExistingDefectsOnCanvas();
    }

    private string GetMaterialDisplay(Anomaly anomaly)
    {
        if (anomaly.Classification == null) return "N/A";

        // If it's a Blade, get the Blade Material (Shell, Web, etc.)
        if (anomaly.Classification.Category == WindBladeInspector.Core.Enums.ComponentCategory.Blade && anomaly.Classification.BladeMaterial.HasValue)
            return anomaly.Classification.BladeMaterial.Value.ToString();

        // If it's an Auxiliary component, get the component type
        if (anomaly.Classification.Category == WindBladeInspector.Core.Enums.ComponentCategory.AuxiliaryComponent && anomaly.Classification.AuxiliaryComponentType.HasValue)
            return anomaly.Classification.AuxiliaryComponentType.Value.ToString();

        return "N/A";
    }

    [JSInvokable]
    public void ReceivePolygonSelection(double[] xCoords, double[] yCoords, double area,
        double boundingWidth, double boundingHeight, double refWidth, double refHeight)
    {
        if (!State.IsDrawingMode) return;
        if (xCoords.Length != 4 || yCoords.Length != 4)
        {
            Logger.LogWarning("Invalid polygon selection: expected 4 points");
            return;
        }

        var rectPoints   = ConvertToRectangle(xCoords, yCoords);
        var dims         = CalculateRectangleDimensions(rectPoints);
        var polygonPoints = new List<double>();
        for (int i = 0; i < 4; i++) { polygonPoints.Add(rectPoints[i].x); polygonPoints.Add(rectPoints[i].y); }

        double scaleX = refWidth  / 100.0;
        double scaleY = refHeight / 100.0;

        State.CurrentWidthPx  = dims.width;
        State.CurrentHeightPx = dims.height;
        State.CurrentWidthPct  = (dims.width  / refWidth)  * 100;
        State.CurrentHeightPct = (dims.height / refHeight) * 100;
        State.CurrentCanvasBoxIndex = State.SelectedImage?.Anomalies.Count ?? 0;

        State.CurrentAnomaly = new Anomaly
        {
            AnomalyId    = $"RECT#{DateTime.Now.Ticks % 10000:X4}",
            RadiusMeters = State.SelectedImage?.PositionMeters ?? 0,
            BladeSide    = State.SelectedView ?? "PS",
            WidthCm      = dims.width  / scaleX,
            HeightCm     = dims.height / scaleY,
            AreaCm2      = area / (scaleX * scaleY),
            Type         = "Other",
            Classification = null,
            Coordinates  = new ImageCoordinates
            {
                PolygonPoints  = polygonPoints,
                ReferenceWidth = refWidth,
                ReferenceHeight = refHeight,
                X      = rectPoints.Min(p => p.x),
                Y      = rectPoints.Min(p => p.y),
                Width  = dims.width,
                Height = dims.height,
            }
        };
        StateHasChanged();
    }

    private (double x, double y)[] ConvertToRectangle(double[] xCoords, double[] yCoords)
    {
        double cx = xCoords.Average(), cy = yCoords.Average();
        var pts = Enumerable.Range(0, 4)
            .Select(i => (x: xCoords[i], y: yCoords[i]))
            .OrderBy(p => Math.Atan2(p.y - cy, p.x - cx))
            .ToList();

        double maxDist = 0; int p1 = 0, p2 = 1;
        for (int i = 0; i < 4; i++)
        {
            int j = (i + 1) % 4;
            double d = Math.Sqrt(Math.Pow(pts[j].x - pts[i].x, 2) + Math.Pow(pts[j].y - pts[i].y, 2));
            if (d > maxDist) { maxDist = d; p1 = i; p2 = j; }
        }

        double angle = Math.Atan2(pts[p2].y - pts[p1].y, pts[p2].x - pts[p1].x);
        double cosA  = Math.Cos(angle), sinA = Math.Sin(angle);

        var proj = pts.Select(p => (
            u:  (p.x - cx) * cosA + (p.y - cy) * sinA,
            v: -(p.x - cx) * sinA + (p.y - cy) * cosA
        )).ToList();

        double minU = proj.Min(p => p.u), maxU = proj.Max(p => p.u);
        double minV = proj.Min(p => p.v), maxV = proj.Max(p => p.v);

        return new[]
        {
            (u: minU, v: minV), (u: maxU, v: minV),
            (u: maxU, v: maxV), (u: minU, v: maxV)
        }.Select(c => (
            x: cx + c.u * cosA - c.v * sinA,
            y: cy + c.u * sinA + c.v * cosA
        )).ToArray();
    }

    private (double width, double height) CalculateRectangleDimensions((double x, double y)[] corners) =>
    (
        Math.Sqrt(Math.Pow(corners[1].x - corners[0].x, 2) + Math.Pow(corners[1].y - corners[0].y, 2)),
        Math.Sqrt(Math.Pow(corners[3].x - corners[0].x, 2) + Math.Pow(corners[3].y - corners[0].y, 2))
    );

    private async Task CancelDefect()
    {
        try
        {
            if (State.IsCanvasInitialized)
            {
                await JSRuntime.InvokeVoidAsync("inspectionCanvas.cancelCurrentDrawing");
                try { await JSRuntime.InvokeVoidAsync("inspectionCanvas.removeBoxByIndex", State.CurrentCanvasBoxIndex); }
                catch { await JSRuntime.InvokeVoidAsync("inspectionCanvas.removeLastBox"); }

                // Tell the JavaScript canvas to stop drawing and go back to normal
                await JSRuntime.InvokeVoidAsync("inspectionCanvas.setMode", "inspect");
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error cancelling defect"); }
        finally
        {
            State.CurrentAnomaly = null;
            State.CurrentCanvasBoxIndex = -1;
            State.CurrentWidthPx = State.CurrentHeightPx = State.CurrentWidthPct = State.CurrentHeightPct = 0;

            // 🚀 NEW FIX: Tell C# that the drawing mode is now OFF
            State.IsDrawingMode = false;

            StateHasChanged();
        }
    }

    private async Task ZoomIn()
    {
        State.ZoomLevel = Math.Min(State.ZoomLevel + 0.1, 3.0);
        if (State.IsCanvasInitialized)
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.setZoom", State.ZoomLevel);
        StateHasChanged();
    }

    private async Task ZoomOut()
    {
        State.ZoomLevel = Math.Max(State.ZoomLevel - 0.1, 0.1);
        if (State.IsCanvasInitialized)
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.setZoom", State.ZoomLevel);
        StateHasChanged();
    }

    private async Task ResetView()
    {
        if (State.IsCanvasInitialized)
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.resetView");
        StateHasChanged();
    }

    private async void SelectImageDirect(InspectionImage img)
    {
        State.SelectedImage = img;
        State.ImageUrl = img.ImageUrl;

        // FIX: Clear the canvas so defects from previous images are wiped out
        try { await JSRuntime.InvokeVoidAsync("inspectionCanvas.clearAll"); } catch { }

        // Disable drawing mode when switching images so you don't draw by accident
        State.IsDrawingMode = false;

        State.SelectedView = State.SelectedBlade?.Views.FirstOrDefault(v => v.Images.Contains(img))?.Side ?? State.SelectedView;
        State.IsCanvasInitialized = false;
        State.CurrentAnomaly = null;

        StateHasChanged();
        await Task.Delay(150);

        // This loads only defects linked to the new image
        await LoadExistingDefectsOnCanvas();
    }

    private async Task LoadExistingDefectsOnCanvas()
    {
        // 1. Safety check
        if (State.SelectedImage == null || !State.IsCanvasInitialized) return;

        try
        {
            // FIX: Tell JS to wipe all shapes from the canvas before loading new ones
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.clearAll");

            // 2. Filter list: Ensure we ONLY grab defects strictly belonging to THIS image
            var defectsForThisImage = State.SelectedImage.Anomalies
                .Where(a => a.Coordinates != null)
                .ToList();

            if (!defectsForThisImage.Any()) return;

            // 3. Map the filtered list to the JS format
            var boxes = defectsForThisImage.Select(a => new
            {
                points = a.Coordinates.IsPolygon
                    ? ConvertPolygonPointsToJsFormat(a.Coordinates.PolygonPoints)
                    : ConvertRectToPolygonPoints(a.Coordinates),
                id = a.AnomalyId.GetHashCode(),
                area = a.Coordinates.GetAreaInPixels(),
                bounds = new { a.Coordinates.X, a.Coordinates.Y, a.Coordinates.Width, a.Coordinates.Height },

                // SENDING ALL 3 METRICS TO JS
                type = GetShortDefectDisplay(a),
                severity = a.Severity,
                material = GetMaterialDisplay(a) 
            }).ToList();

            // 4. Draw only the filtered boxes
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.loadAnomalies", boxes);
            Logger.LogInformation("Loaded {Count} defects for image {Id}", boxes.Count, State.SelectedImage.Id);
        }
        catch (Exception ex) { Logger.LogError(ex, "Error refreshing canvas"); }
    }

    private object[] ConvertPolygonPointsToJsFormat(List<double> pts)
    {
        if (pts == null || pts.Count != 8) return Array.Empty<object>();
        return Enumerable.Range(0, 4)
            .Select(i => (object)new { x = pts[i * 2], y = pts[i * 2 + 1] })
            .ToArray();
    }

    private object[] ConvertRectToPolygonPoints(ImageCoordinates c) => new[]
    {
        (object)new { x = c.X,           y = c.Y            },
        (object)new { x = c.X + c.Width, y = c.Y            },
        (object)new { x = c.X + c.Width, y = c.Y + c.Height },
        (object)new { x = c.X,           y = c.Y + c.Height }
    };

    private bool _isGeneratingReport = false;

    protected async Task GenerateReport()
    {
        if (State.Project == null || _isGeneratingReport) return;
        _isGeneratingReport = true;
        StateHasChanged();
        try
        {
            var pdfBytes = await ReportService.GenerateProjectReportAsync(State.Project);
            var fileName = $"WTG_Report_{State.Project.TurbineId}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";
            using var streamRef = new DotNetStreamReference(new System.IO.MemoryStream(pdfBytes), leaveOpen: false);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, "application/pdf", streamRef);
            Logger.LogInformation("PDF download triggered – {TurbineId}", State.Project.TurbineId);
        }
        catch (Exception ex) { Logger.LogError(ex, "PDF generation failed for {TurbineId}", State.Project?.TurbineId); }
        finally { _isGeneratingReport = false; StateHasChanged(); }
    }

    private void DeleteImage(InspectionImage img)
    {
        if (State.SelectedBlade == null) return;
        foreach (var view in State.SelectedBlade.Views)
        {
            if (!view.Images.Remove(img)) continue;
            UpdateSelectedViewImages();
            if (State.SelectedViewImages.Count > 0)
                SelectImageDirect(State.SelectedViewImages.First());
            else { State.SelectedImage = null; State.ImageUrl = string.Empty; }
            break;
        }
        StateHasChanged();
    }

    private void NavigateBack() => Navigation.NavigateTo("/");

    public async ValueTask DisposeAsync()
    {
        (State.DotNetRef as IDisposable)?.Dispose();
    }

    private void NextImage()
    {
        if (State.SelectedViewImages.Count == 0 || State.SelectedImage == null) return;
        var idx = State.SelectedViewImages.IndexOf(State.SelectedImage);
        if (idx < State.SelectedViewImages.Count - 1)
            SelectImageDirect(State.SelectedViewImages[idx + 1]);
    }

    private void PrevImage()
    {
        if (State.SelectedViewImages.Count == 0 || State.SelectedImage == null) return;
        var idx = State.SelectedViewImages.IndexOf(State.SelectedImage);
        if (idx > 0) SelectImageDirect(State.SelectedViewImages[idx - 1]);
    }

    private bool CanNavigateNext() =>
        State.SelectedViewImages.Count > 0 && State.SelectedImage != null &&
        State.SelectedViewImages.IndexOf(State.SelectedImage) < State.SelectedViewImages.Count - 1;

    private bool CanNavigatePrev() =>
        State.SelectedViewImages.Count > 0 && State.SelectedImage != null &&
        State.SelectedViewImages.IndexOf(State.SelectedImage) > 0;

    private void DeleteCurrentImage() { if (State.SelectedImage != null) DeleteImage(State.SelectedImage); }

    private async Task DeleteAnomaly()
    {
        if (State.SelectedAnomaly == null) return;

        // FIX: Remove using AnomalyId because memory references might differ
        State.SelectedBlade?.Anomalies.RemoveAll(a => a.AnomalyId == State.SelectedAnomaly.AnomalyId);
        State.SelectedImage?.Anomalies.RemoveAll(a => a.AnomalyId == State.SelectedAnomaly.AnomalyId);

        // Persist so the dashboard defect count reflects the deletion
        if (State.Project != null)
            DashboardService.SaveProject(State.Project);

        State.SelectedAnomaly = null;

        // Rebuild canvas to remove the deleted box
        try
        {
            if (State.IsCanvasInitialized)
            {
                await JSRuntime.InvokeVoidAsync("inspectionCanvas.clearAll");
                await LoadExistingDefectsOnCanvas();
            }
        }
        catch (Exception ex) { Logger.LogError(ex, "Error refreshing canvas after delete"); }

        StateHasChanged();
    }

    private async Task ToggleVisualMode()
    {
        State.IsVisualMode = !State.IsVisualMode;
        await Task.Delay(80);
        if (State.IsCanvasInitialized)
            await JSRuntime.InvokeVoidAsync("inspectionCanvas.resetView");
        StateHasChanged();
    }
}