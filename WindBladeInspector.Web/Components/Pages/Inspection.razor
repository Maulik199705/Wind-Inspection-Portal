@* CONTEXT FOR COPILOT:
// This Blazor page is too large and needs architectural refactoring.
// Goal:
// - Split into multiple Razor components
// - Extract state into InspectionState.cs
// - Move business logic into controllers/services
// - Keep behavior IDENTICAL
*@

@page "/inspection"
@page "/inspection/{ProjectId:guid}"
@using WindBladeInspector.Core.Services
@using WindBladeInspector.Core.Entities
@using WindBladeInspector.Core.Interfaces
@using WindBladeInspector.Web.InspectionLogic
@using WindBladeInspector.Web.Components.Inspection
@using Microsoft.JSInterop
@inject DashboardService DashboardService
@inject InspectionCalculationService CalculationService
@inject IFileStorageService FileStorageService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject ILogger<Inspection> Logger
@inject InspectionState State
@inject IReportGenerationService ReportService
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>QualiMax - Blade Inspection</PageTitle>

<div class="app-container @(State.IsVisualMode ? "visual-mode" : "")">
    <header class="app-header">
        <h1>
            <svg class="logo-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C13.1 2 14 2.9 14 4V9.5C14 10.9 14.8 12.1 16 12.7V4C16 2.9 16.9 2 18 2S20 2.9 20 4V13C20 17.4 16.4 21 12 21S4 17.4 4 13V4C4 2.9 4.9 2 6 2S8 2.9 8 4V12.7C9.2 12.1 10 10.9 10 9.5V4C10 2.9 10.9 2 12 2Z" />
            </svg>
            @if (State.Project != null)
            {
                <span class="header-context">
                    @(State.Project.Client) <span class="header-sep">•</span> @(State.Project.ParkName) <span class="header-sep">•</span>
                </span>
                <span class="header-turbine">WTG: @(State.Project.TurbineId)</span>
            }
            else
            {
                <span>Blade Inspection</span>
            }
        </h1>
        <div class="header-nav">
            <span style="color: var(--text-muted); margin-right: 1rem;">@(State.Project?.Model ?? "")</span>
            <button class="btn btn-secondary btn-sm" @onclick="NavigateBack">← Back to Dashboard</button>
        </div>
    </header>

    <div class="inspection-layout @(State.IsLeftPanelCollapsed ? "left-collapsed" : "")">

        <!-- ═══ LEFT SIDEBAR ═══ -->
        <div class="blade-schematic-panel @(State.IsLeftPanelCollapsed ? "collapsed" : "")">
            <button class="panel-collapse-btn left-collapse-btn"
                    @onclick="ToggleLeftPanel"
                    title="@(State.IsLeftPanelCollapsed ? "Expand" : "Collapse") Navigation">
                @(State.IsLeftPanelCollapsed ? "▶" : "◀")
            </button>

            <div class="panel-content">
                <div class="panel-title">Blade Inspection</div>

                <!-- Blade Selector -->
                <div class="blade-selector">
                    @if (State.Project != null)
                    {
                        @foreach (var blade in State.Project.Blades)
                        {
                            <button class="blade-selector-btn @(State.SelectedBlade?.Id == blade.Id ? "active" : "")"
                                    @onclick="() => SelectBlade(blade)">
                                @blade.SerialNumber
                            </button>
                        }
                    }
                </div>

                <!-- View/Side Selector -->
                @if (State.SelectedBlade != null)
                {
                    <div class="nav-section" style="margin-top: 1rem;">
                        <div class="nav-title">Blade Views</div>
                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                            @foreach (var view in new[] { "PS", "SS", "LE", "TE" })
                            {
                                var bladeView  = State.SelectedBlade.Views.FirstOrDefault(v => v.Side == view);
                                var imageCount = bladeView?.Images.Count ?? 0;
                                <button class="view-selector-btn @(State.SelectedView == view ? "active" : "")"
                                        @onclick="() => SelectView(view)"
                                        style="flex: 1; min-width: 40%; position: relative;">
                                    <span>@GetViewLabel(view)</span>
                                    @if (imageCount > 0)
                                    {
                                        <span style="font-size: 0.7rem; display: block; color: #0f0;">@imageCount img</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                <!-- ── NEW DEFECT FORM (fixed in left sidebar, shown when drawing completes) ── -->
                @if (State.CurrentAnomaly != null)
                {
                    <div class="nav-section new-defect-section" style="margin-top: 1rem;">
                        <div class="new-defect-header">
                            <span class="new-defect-title">🎯 New Defect</span>
                            <button class="inline-close-btn" @onclick="CancelDefect" title="Cancel">✕</button>
                        </div>

                        <div class="inline-dims">
                            <div class="dim-item">
                                <span class="dim-label">W</span>
                                <span class="dim-value">@State.CurrentWidthPx.ToString("F0")px</span>
                                <span class="dim-pct">(@State.CurrentWidthPct.ToString("F1")%)</span>
                            </div>
                            <div class="dim-item">
                                <span class="dim-label">H</span>
                                <span class="dim-value">@State.CurrentHeightPx.ToString("F0")px</span>
                                <span class="dim-pct">(@State.CurrentHeightPct.ToString("F1")%)</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Severity</label>
                            <select class="form-select" @bind="State.CurrentAnomaly.Severity">
                                <option value="1">1 – Cosmetic</option>
                                <option value="2">2 – Minor</option>
                                <option value="3">3 – Medium</option>
                                <option value="4">4 – Serious</option>
                                <option value="5">5 – Very Serious</option>
                            </select>
                        </div>

                        <DefectClassificationSelector
                            Classification="@State.CurrentAnomaly.Classification"
                            ClassificationChanged="@OnCurrentDefectClassificationChanged" />

                        <div class="form-group">
                            <label class="form-label">Blade Side</label>
                            <div class="readonly-field">@State.SelectedView – @GetViewLabel(State.SelectedView)</div>
                        </div>

                        <div class="inline-defect-actions">
                            <button class="btn btn-primary" @onclick="SaveAnomaly">✔ Save</button>
                            <button class="btn btn-danger"  @onclick="CancelDefect">✕ Cancel</button>
                        </div>
                    </div>
                }


                <!-- Generate Report -->
                <div class="nav-section" style="margin-top: 0.5rem;">
                    <button class="btn btn-primary" @onclick="GenerateReport"
                            disabled="@_isGeneratingReport" style="width: 100%;">
                        @(_isGeneratingReport ? "⏳ Generating…" : "📄 Generate Report")
                    </button>
                </div>

                <!-- Edit selected saved defect -->
                @if (State.SelectedAnomaly != null && State.CurrentAnomaly == null)
                {
                    <div class="nav-section" style="margin-top: 1rem;">
                        <div class="nav-title">Edit Defect</div>
                        <div class="damage-form">
                            <div class="form-group">
                                <label class="form-label">Severity (1–5)</label>
                                <select class="form-select" @bind="State.SelectedAnomaly.Severity">
                                    <option value="1">1 – Cosmetic</option>
                                    <option value="2">2 – Minor</option>
                                    <option value="3">3 – Medium</option>
                                    <option value="4">4 – Serious</option>
                                    <option value="5">5 – Very Serious</option>
                                </select>
                            </div>
                            <DefectClassificationSelector
                                Classification="@State.SelectedAnomaly.Classification"
                                ClassificationChanged="@OnSelectedDefectClassificationChanged" />
                            <div class="form-group">
                                <label class="form-label">Blade Side</label>
                                <select class="form-select" @bind="State.SelectedAnomaly.BladeSide">
                                    <option value="PS">Pressure Side</option>
                                    <option value="SS">Suction Side</option>
                                    <option value="LE">Leading Edge</option>
                                    <option value="TE">Trailing Edge</option>
                                </select>
                            </div>
                            <button class="btn btn-primary btn-block" @onclick="UpdateAnomaly">Update Defect</button>
                            <button class="btn btn-block" @onclick="DeleteAnomaly"
                                    style="margin-top: 5px; background: #442222; border-color: #663333; color: #ff9999;">
                                Delete Defect
                            </button>
                        </div>
                    </div>
                }

                <!-- Defect Summary -->
                <div class="nav-section" style="margin-top: 1rem; flex: 1; overflow: hidden; display: flex; flex-direction: column;">
                    <div class="nav-title">Defect Summary (@State.SelectedView)</div>
                    <div class="anomaly-list" style="overflow-y: auto;">
                        @if (State.SelectedBlade != null && State.SelectedBlade.Anomalies.Any())
                        {
                            var filtered = State.SelectedBlade.Anomalies
                                .Where(a => a.BladeSide == State.SelectedView)
                                .OrderByDescending(a => a.Severity)
                                .ToList();

                            @if (filtered.Any())
                            {
                                foreach (var anomaly in filtered)
                                {
                                    <div class="anomaly-list-item @(State.SelectedAnomaly?.Id == anomaly.Id ? "selected" : "")"
                                         @onclick="() => SelectAnomaly(anomaly)"
                                         title="@anomaly.GetDefectTypeDisplay()">
                                        <div class="anomaly-severity-dot severity-dot-@anomaly.Severity"></div>
                                        <div class="anomaly-list-info">
                                            <div class="anomaly-list-type">@GetShortDefectDisplay(anomaly)</div>
                                            <div class="anomaly-list-location">Severity @anomaly.Severity • @anomaly.BladeSide</div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state-text">No defects in @State.SelectedView view</div>
                            }
                        }
                        else
                        {
                            <div class="empty-state-text">No defects recorded</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ CENTER PANEL ═══ -->
        <div class="center-panel">
            <!-- Image Navigation Bar -->
            <div class="image-navigation-bar">
                <div class="image-nav-content">
                    <button class="nav-arrow-btn" @onclick="PrevImage" disabled="@(!CanNavigatePrev())" title="Previous Image">❮</button>

                    <div class="image-number-list">
                        @if (State.SelectedViewImages.Count > 0)
                        {
                            @for (int i = 0; i < State.SelectedViewImages.Count; i++)
                            {
                                var img        = State.SelectedViewImages[i];
                                var index      = i;
                                var isActive   = State.SelectedImage?.Id == img.Id;
                                var hasDefects = img.Anomalies.Any();
                                <button class="image-number-btn @(isActive ? "active" : "") @(hasDefects ? "has-defects" : "")"
                                        @onclick="() => SelectImageDirect(img)"
                                        title="@($"Image {index + 1}{(hasDefects ? $" ({img.Anomalies.Count} defects)" : "")}")">
                                    @(index + 1)
                                </button>
                            }
                        }
                        else
                        {
                            <span style="color: #666; font-size: 0.85rem; padding: 0 15px;">No images for @State.SelectedView</span>
                        }
                    </div>

                    <button class="nav-arrow-btn" @onclick="NextImage" disabled="@(!CanNavigateNext())" title="Next Image">❯</button>

                    <div class="image-info-compact">
                        @if (State.SelectedImage != null)
                        {
                            <span>@(State.SelectedImage.SequenceOrder + 1) / @State.SelectedViewImages.Count</span>
                            @if (State.SelectedImage.Anomalies.Any())
                            {
                                <span class="defect-count-badge">@State.SelectedImage.Anomalies.Count defects</span>
                            }
                        }
                    </div>

                    <button class="btn-delete-image" @onclick="DeleteCurrentImage" disabled="@(State.SelectedImage == null)" title="Delete Image">🗑️</button>
                </div>
            </div>

            <!-- Inspection Header / Controls -->
            <div class="inspection-header">
                <div class="blade-info">
                    <span class="blade-id">@(State.SelectedBlade?.SerialNumber ?? "—")</span>
                    <span class="project-info">@State.SelectedView – @GetViewLabel(State.SelectedView)</span>
                </div>
                <div class="canvas-controls">
                    <button class="btn-icon @(State.IsDrawingMode ? "btn-danger" : "btn-primary")"
                            @onclick="ToggleDrawingMode"
                            title="Add Defect">

                        <!-- SVG: Rectangle with a Dot in the Middle -->
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 5px;">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <circle cx="12" cy="12" r="2.5" fill="currentColor" />
                        </svg>

                        @(State.IsDrawingMode ? "✕ Stop" : "")
                    </button>

                    <div class="divider"></div>
                    <button class="btn-icon" @onclick="ZoomIn"    title="Zoom In (+)">+</button>
                    <span class="zoom-level">@((State.ZoomLevel * 100).ToString("F0"))%</span>
                    <button class="btn-icon" @onclick="ZoomOut"   title="Zoom Out (-)">−</button>
                    <button class="btn-icon" @onclick="ResetView" title="Fit to Screen">⊡</button>
                    <div class="divider"></div>
                    <button class="btn-icon btn-fullscreen" @onclick="ToggleVisualMode"
                            title="@(State.IsVisualMode ? "Exit Fullscreen (Esc)" : "Fullscreen")">
                        @(State.IsVisualMode ? "✕" : "⛶")
                    </button>
                </div>
            </div>

            <!-- ── Canvas Area (no floating defect panel here anymore) ── -->
            <div class="main-content">
                <div class="canvas-panel">
                    <div class="canvas-container-wrapper" id="canvasViewer">
                        @if (string.IsNullOrEmpty(State.ImageUrl))
                        {
                            <div class="empty-state">
                                <svg class="empty-state-icon" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/>
                                </svg>
                                <h3>No Image Selected</h3>
                                <p>Select an image from the navigation bar above</p>
                            </div>
                        }
                        else
                        {
                            <div class="canvas-container" id="canvasContainer">
                                <img id="bladeImage" src="@State.ImageUrl" @onload="OnImageLoaded" alt="Blade Image" />
                                <canvas id="inspectionCanvas"></canvas>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Visual Mode overlay ── -->
<div class="visual-controls">
    <button class="floating-btn" @onclick="PrevImage"         title="Previous">❮</button>
    <button class="floating-btn" @onclick="ZoomOut"           title="Zoom Out">−</button>
    <button class="floating-btn primary" @onclick="ToggleVisualMode" title="Exit Fullscreen">✕ Exit</button>
    <button class="floating-btn" @onclick="ZoomIn"            title="Zoom In">+</button>
    <button class="floating-btn" @onclick="NextImage"         title="Next">❯</button>
</div>

<style>
/* ═══════════════════════════════════════════════════════════════════
   LAYOUT
═══════════════════════════════════════════════════════════════════ */
.inspection-layout {
    display: grid;
    grid-template-columns: 350px 1fr;
    height: calc(100vh - 60px);
    overflow: hidden;
    transition: grid-template-columns 0.25s ease;
}
.inspection-layout.left-collapsed { grid-template-columns: 36px 1fr; }
    /* Header text formatting */
    .header-context {
        font-weight: 500;
        color: #aaaaaa;
    }

    .header-turbine {
        font-weight: bold;
        color: #ffffff;
    }

    .header-sep {
        color: #555555;
        margin: 0 6px;
        font-weight: normal;
    }
/* ═══════════════════════════════════════════════════════════════════
   LEFT SIDEBAR
═══════════════════════════════════════════════════════════════════ */
.blade-schematic-panel {
    background: #1e1e1e;
    display: flex;
    flex-direction: row;
    overflow: hidden;
    border-right: 1px solid #2a2a2a;
    position: relative;
}

.blade-schematic-panel .panel-content {
    order: 1;
    flex: 1;
    min-width: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 15px;
    display: flex;
    flex-direction: column;
    transition: opacity 0.2s, visibility 0.2s;
    visibility: visible;
    opacity: 1;
}
.blade-schematic-panel.collapsed .panel-content {
    flex: 0 0 0px;
    min-width: 0;
    max-width: 0;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

/* ── New Defect section — green highlight to draw attention ── */
.new-defect-section {
    background: rgba(0, 255, 0, 0.04);
    border: 1px solid #0f0;
    border-radius: 6px;
    padding: 10px;
}

.new-defect-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}
.new-defect-title { font-size: 0.9rem; font-weight: bold; color: #0f0; }

.inline-close-btn {
    background: none;
    border: 1px solid #444;
    color: #aaa;
    border-radius: 4px;
    padding: 2px 7px;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 0.15s;
}
.inline-close-btn:hover { background: #442222; border-color: #ff4444; color: #fff; }

.inline-dims {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
    background: #111;
    padding: 6px 8px;
    border-radius: 4px;
}
.dim-item  { display: flex; align-items: baseline; gap: 3px; }
.dim-label { color: #666; font-size: 0.72rem; }
.dim-value { color: #0f0; font-weight: bold; font-size: 0.8rem; }
.dim-pct   { color: #555; font-size: 0.68rem; }

.inline-defect-actions { display: flex; gap: 8px; margin-top: 10px; }
.inline-defect-actions .btn { flex: 1; }

/* ═══════════════════════════════════════════════════════════════════
   COLLAPSE BUTTON
═══════════════════════════════════════════════════════════════════ */
.panel-collapse-btn {
    order: 2;
    flex: 0 0 36px;
    width: 36px;
    min-width: 36px;
    max-width: 36px;
    background: #1a1a1a;
    border: none;
    color: #0f0;
    font-size: 0.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, color 0.2s;
    z-index: 10;
    position: relative;
}
.panel-collapse-btn:hover { background: #252525; color: #fff; }
.left-collapse-btn { border-left: 1px solid #333; }

/* ═══════════════════════════════════════════════════════════════════
   CENTER PANEL
═══════════════════════════════════════════════════════════════════ */
.center-panel {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #0d0d0d;
    min-width: 0;
}

.main-content {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

.canvas-panel {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    min-height: 0;
}

/* ═══════════════════════════════════════════════════════════════════
   CANVAS
═══════════════════════════════════════════════════════════════════ */
.canvas-container-wrapper {
    flex: 1;
    overflow: hidden;
    position: relative;
    background: #0d0d0d;
    min-height: 0;
}

.canvas-container {
    position: absolute;
    top: 0; left: 0;
    transform-origin: 0 0;
    line-height: 0;
    box-shadow: 0 0 40px rgba(0,0,0,0.6);
}

.canvas-container img { display: block; }
.canvas-container canvas {
    display: block;
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    cursor: crosshair;
}

/* ═══════════════════════════════════════════════════════════════════
   EMPTY STATE
═══════════════════════════════════════════════════════════════════ */
.empty-state {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #555;
    text-align: center;
    padding: 2rem;
}

/* ═══════════════════════════════════════════════════════════════════
   SHARED FORM HELPERS
═══════════════════════════════════════════════════════════════════ */
.readonly-field {
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 4px;
    padding: 8px 10px;
    color: #0f0;
    font-weight: 600;
    font-size: 0.85rem;
}

.btn-danger             { background: #442222; border: 1px solid #663333; color: #ff9999; }
.btn-danger:hover       { background: #663333; border-color: #ff4444; color: #fff; }

/* ═══════════════════════════════════════════════════════════════════
   QUICK ACTIONS
═══════════════════════════════════════════════════════════════════ */
/* .quick-actions-hint { background: #1a2332; border: 1px solid #0f0; border-radius: 4px; padding: 10px; margin-bottom: 4px; }
.hint-title         { font-size: 0.8rem; color: #0f0; font-weight: bold; margin-bottom: 6px; }
.hint-body          { font-size: 0.72rem; color: #aaa; line-height: 1.7; } */

/* ═══════════════════════════════════════════════════════════════════
   IMAGE NAVIGATION BAR
═══════════════════════════════════════════════════════════════════ */
.image-navigation-bar {
    background: #1a1a1a;
    border-bottom: 2px solid #0f0;
    padding: 8px 12px;
    display: flex;
    align-items: center;
    min-height: 48px;
    flex-shrink: 0;
}
.image-nav-content { display: flex; align-items: center; gap: 8px; width: 100%; }

.nav-arrow-btn {
    background: #2a2a2a; border: 2px solid #444; color: #0f0;
    padding: 6px 14px; border-radius: 4px; cursor: pointer;
    font-size: 1.1rem; font-weight: bold; transition: all 0.2s; min-width: 44px;
}
.nav-arrow-btn:hover:not(:disabled) { background: #0f0; color: #000; border-color: #0f0; }
.nav-arrow-btn:disabled             { opacity: 0.3; cursor: not-allowed; }

.image-number-list {
    display: flex; gap: 5px; flex-wrap: nowrap;
    flex: 1; align-items: center; overflow-x: auto; padding: 2px 0;
}

.image-number-btn {
    background: #2a2a2a; border: 2px solid #444; color: #aaa;
    padding: 6px 12px; border-radius: 4px; cursor: pointer;
    font-size: 0.85rem; font-weight: 600; transition: all 0.2s;
    min-width: 38px; position: relative; flex-shrink: 0;
}
.image-number-btn:hover   { background: #333; border-color: #666; color: #fff; }
.image-number-btn.active  { background: #0f0; color: #000; border-color: #0f0; font-weight: bold; box-shadow: 0 0 8px rgba(0,255,0,0.4); }
.image-number-btn.has-defects::after {
    content: ''; position: absolute; top: 2px; right: 2px;
    width: 6px; height: 6px; background: #ff4444; border-radius: 50%;
    box-shadow: 0 0 4px rgba(255,68,68,0.8);
}

.image-info-compact {
    display: flex; gap: 8px; align-items: center; color: #aaa;
    font-size: 0.8rem; white-space: nowrap; padding: 0 8px; border-left: 1px solid #333;
}
.defect-count-badge { background: #ff4444; color: #fff; padding: 1px 7px; border-radius: 10px; font-size: 0.72rem; font-weight: bold; }

.btn-delete-image {
    background: #442222; border: 2px solid #663333; color: #ff6666;
    padding: 6px 10px; border-radius: 4px; cursor: pointer; font-size: 0.9rem; transition: all 0.2s;
}
